{
  "feature_sets": ["set_1"],

  "pipelines": [
    {
      "sampling": "oversampling",

      "models": {
        "gradient_boosting": {
          "type": "single",
          "scaling": false,
          "threshold": [0.5],
          "params": [
            {
              "n_estimators": 300,
              "learning_rate": 0.05,
              "max_depth": 4,
              "subsample": 0.8,
              "random_state": 42
            },
            {
              "n_estimators": 500,
              "learning_rate": 0.03,
              "max_depth": 3,
              "subsample": 0.7,
              "random_state": 42
            },
            {
              "n_estimators": 250,
              "learning_rate": 0.08,
              "max_depth": 5,
              "subsample": 0.9,
              "random_state": 42
            },
            {
              "n_estimators": 200,
              "learning_rate": 0.1,
              "max_depth": 3,
              "subsample": 0.8,
              "random_state": 42
            }
          ]
        }
      }
    }
  ],

  "splits": {
    "80_20": { "cv": false },
    "70_30": { "cv": false }
  },

  "time_based": {
    "enable": false,
    "cv": false
  },

  "full": {
    "enable": true,
    "cv": false
  }
}
